<Window x:Class="Banklycs.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Banklycs - Studio Console"
        Icon="app.ico"
        Width="1280" Height="800"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#161616">
    <Grid>
        <wv2:WebView2 x:Name="WebView"
                      DefaultBackgroundColor="#161616" />
        <!-- Loading overlay shown while the engine boots and the first page loads -->
        <Border x:Name="LoadingOverlay"
                Background="#161616"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="BANKLYCS"
                           FontSize="34" FontWeight="Bold"
                           Foreground="#ff9f0a"
                           HorizontalAlignment="Center" />
                <TextBlock x:Name="LoadingText"
                           Text="Menyiapkan Studio Console..."
                           FontSize="14"
                           Foreground="#a6a6ab"
                           Margin="0,12,0,0"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
