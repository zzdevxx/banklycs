# ==============================================================================
# Banklycs - .gitignore
# ==============================================================================

# OS & Environment
Thumbs.db
Desktop.ini
.DS_Store
*.tmp

# .NET / C# Build Artifacts
[Bb]in/
[Oo]bj/
*.user
*.suo
.vs/
.idea/
*.vscode/

# Python Cache & Scraper Temps
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
*.log

# Engine Output & Logs
engine/last_errors.txt

# Generated Presentations (Binary Protobuf)
# File .pro dapat di-generate ulang kapan saja via engine
engine/PRO/*.pro
!engine/PRO/.gitkeep
PRO
TXT

# Archives & Large Backups
*.zip
*.tar.gz
*.7z
