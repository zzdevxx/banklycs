# ==============================================================================
# Banklycs - .gitignore
# ==============================================================================

# OS & Environment
Thumbs.db
Desktop.ini
.DS_Store
*.tmp

# .NET / C# Build Artifacts
[Bb]in/
[Oo]bj/
[Pp]ublish/
publish/
*.user
*.suo
*.pdb
.vs/
.idea/
*.vscode/

# SQLite Temporary Cache & WAL
*.db-wal
*.db-shm
*.db-journal

# Database Single-File Tracking
!database/banklycs.db

# Loose File Dumps (if user runs export-txt)
database/txt/
database/pro/
/PRO
/TXT

# Python Cache & Scraper Temps
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
*.log

# Engine Output & Logs
engine/last_errors.txt
engine/last_port.txt
engine/test_export/

# Archives & Large Backups
*.zip
*.tar.gz
*.7z
